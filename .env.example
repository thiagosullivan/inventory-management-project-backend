# NeonDB Connection String (coloque a sua real do painel do Neon)
DATABASE_URL=

# Better Auth
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=

# Servidor
PORT=3000
NODE_ENV=development

# CORS — lista separada por vírgula (sem espaços)
# Dev: http://localhost:5173,http://localhost:4173
# Prod: https://stockifyapp.com.br,https://*.stockifyapp.com.br
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# UploadThing
UPLOADTHING_TOKEN=
UPLOADTHING_SECRET=

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Stockify <no-reply@stockify.local>"
APP_URL=http://localhost:5173